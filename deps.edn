{:paths ["src"]

 ;; Deliberately small. hive-build sits on the release path of every hive
 ;; package, so its dependency surface is part of its contract.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        io.github.clojure/tools.build {:mvn/version "0.10.14"}
        slipset/deps-deploy {:mvn/version "0.2.5"}
        metosin/malli {:mvn/version "0.20.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.3.12"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.14"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Dogfood: hive-build publishes itself with the published hive-build.api,
  ;; exactly like every downstream consumer. No local build.clj.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.9"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}

  :nrepl {:extra-paths ["test"]
          :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.hive-agi/hive-test {:mvn/version "0.3.12"}
                       io.github.hive-agi/hive-schemas {:mvn/version "0.1.14"}
                       nrepl/nrepl {:mvn/version "1.7.0"}
                       cider/cider-nrepl {:mvn/version "0.62.2"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"
                      "--port" "7932"]}}}
